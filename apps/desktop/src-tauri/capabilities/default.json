{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: core APIs, opening license links in the browser, and the daemon sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "opener:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/common",
          "sidecar": true,
          "args": ["serve", "--host", "127.0.0.1", "--port", { "validator": "^[0-9]{2,5}$" }]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/common",
          "sidecar": true,
          "args": ["serve", "--host", "127.0.0.1", "--port", { "validator": "^[0-9]{2,5}$" }]
        }
      ]
    }
  ]
}
