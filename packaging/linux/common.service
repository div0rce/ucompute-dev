# systemd user unit for the UCompute daemon (formerly Common; the binary is still `common`).
# Install and remove: packaging/linux/README.md. Data: $XDG_DATA_HOME/common or ~/.local/share/common.
[Unit]
Description=UCompute daemon (common serve, API on 127.0.0.1:8192)

[Service]
ExecStart=%h/.local/bin/common serve --host 127.0.0.1 --port 8192
Restart=on-failure
RestartSec=2
# KillMode=control-group (the default) stops the engine (llama-server) together with the daemon.

[Install]
WantedBy=default.target
