{
  "openapi": "3.1.0",
  "info": {
    "title": "Common local API",
    "version": "1.0.0",
    "description": "OpenAI-compatible inference endpoints under /v1 plus Common extensions under /api. Binds 127.0.0.1 by default. Every error body has the OpenAI shape with a stable Common `code` (see Error). When the server was started with an API key, every route except /health requires `Authorization: Bearer <key>`. Browser requests (an `Origin` header) are accepted only from the allow-listed desktop origins; any other origin, a cross-site fetch, or (without an API key) a non-loopback `Host` gets 403 `policy_denied` before the route runs.",
    "license": { "name": "Apache-2.0" }
  },
  "servers": [{ "url": "http://127.0.0.1:8192" }],
  "security": [{}, { "bearer": [] }],
  "tags": [
    { "name": "ops", "description": "Liveness, readiness, metrics, this document." },
    { "name": "openai", "description": "OpenAI-compatible endpoints; official OpenAI clients work with only base_url changed." },
    { "name": "common", "description": "Common extensions used by the CLI and the desktop app." },
    { "name": "mesh", "description": "Common Mesh (M3): peer networking, pairing, trust, privacy and audit. Everything is off by default; nothing leaves this device unless privacy is `trusted_group` and the request names a paired device with `target`." }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["ops"],
        "summary": "Liveness",
        "description": "Always 200 while the process runs. Never requires authentication.",
        "security": [{}],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "const": "ok" }, "version": { "type": "string" } }, "required": ["status", "version"] } } } } }
      }
    },
    "/ready": {
      "get": {
        "tags": ["ops"],
        "summary": "Readiness",
        "description": "200 when a request could be served now: no model is loaded (the server can accept a load), or the loaded engine answers a tokenize round-trip within 2 s. 503 while a load holds the slot or the engine is unresponsive.",
        "responses": {
          "200": { "description": "Ready", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "const": "ready" }, "model": { "type": ["string", "null"] } } } } } },
          "503": { "description": "Not ready", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "const": "not_ready" }, "reason": { "type": "string" } } } } } }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["ops"],
        "summary": "Prometheus metrics",
        "description": "Text exposition format. Metrics: common_requests_total{route,status}, common_requests_rejected_total{reason}, common_tokens_generated_total, common_prompt_tokens_total, common_ttft_seconds (histogram), common_decode_tokens_per_second, common_queue_depth, common_inflight. Never contains prompt or completion text.",
        "responses": { "200": { "description": "Metrics", "content": { "text/plain": { "schema": { "type": "string" } } } } }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["ops"],
        "summary": "This document",
        "responses": { "200": { "description": "OpenAPI 3.1 document", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/v1/models": {
      "get": {
        "tags": ["openai"],
        "summary": "List models",
        "description": "Every model in the local store plus catalog entries not downloaded yet. Each object carries a `common` extension with download/load state.",
        "responses": { "200": { "description": "Model list", "content": { "application/json": { "schema": { "type": "object", "properties": { "object": { "const": "list" }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/Model" } } } } } } } }
      }
    },
    "/v1/models/{id}": {
      "get": {
        "tags": ["openai"],
        "summary": "Retrieve a model",
        "parameters": [{ "$ref": "#/components/parameters/ModelId" }],
        "responses": { "200": { "description": "Model", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Model" } } } }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "tags": ["openai"],
        "summary": "Chat completion",
        "description": "Loads `model` on demand (single slot). Models whose GGUF has a chat template get the template applied by the engine; models without one (e.g. the stories15M fixture) are prompted with plain `role: content` lines. `response_format` of type json_schema/json_object enables constrained decoding. With `stream: true` the response is text/event-stream: OpenAI chat chunks, a final chunk with finish_reason, a usage chunk when stream_options.include_usage is set, then `data: [DONE]`. Closing the connection cancels generation.",
        "parameters": [{ "$ref": "#/components/parameters/Target" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatRequest" } } } },
        "responses": {
          "200": { "description": "Completion (JSON) or SSE stream", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatResponse" } }, "text/event-stream": { "schema": { "type": "string" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/completions": {
      "post": {
        "tags": ["openai"],
        "summary": "Text completion",
        "description": "Raw prompt (string or single-element array), no chat template. Same sampling, streaming and admission rules as chat.",
        "parameters": [{ "$ref": "#/components/parameters/Target" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CompletionRequest" } } } },
        "responses": {
          "200": { "description": "Completion (JSON) or SSE stream", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CompletionResponse" } }, "text/event-stream": { "schema": { "type": "string" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/embeddings": {
      "post": {
        "tags": ["openai"],
        "summary": "Embeddings",
        "description": "Loads `model` in embeddings mode (reloading the slot if it was loaded for generation).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmbeddingsRequest" } } } },
        "responses": {
          "200": { "description": "Embeddings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmbeddingsResponse" } } } },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/hardware": {
      "get": {
        "tags": ["common"],
        "summary": "Hardware probe",
        "description": "Fresh `common_hardware::probe()` report: cpu, memory, gpus, backends, disk.",
        "responses": { "200": { "description": "Hardware report", "content": { "application/json": { "schema": { "type": "object" } } } }, "500": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/status": {
      "get": {
        "tags": ["common"],
        "summary": "Daemon status",
        "responses": { "200": { "description": "Status", "content": { "application/json": { "schema": { "type": "object", "properties": { "version": { "type": "string" }, "uptime_seconds": { "type": "integer" }, "loaded": { "oneOf": [{ "$ref": "#/components/schemas/LoadedModelInfo" }, { "type": "null" }] }, "queue": { "type": "object", "properties": { "inflight": { "type": "integer" }, "queued": { "type": "integer" }, "max_concurrent": { "type": "integer" }, "max_queue": { "type": "integer" } } } } } } } } }
      }
    },
    "/api/models": {
      "get": {
        "tags": ["common"],
        "summary": "Model library with fit estimates",
        "description": "Store manifests plus catalog entries not downloaded, each with a memory estimate and a fit verdict for this device (GGUF-based when the blob is present, file-size-only otherwise).",
        "responses": { "200": { "description": "Models", "content": { "application/json": { "schema": { "type": "object", "properties": { "models": { "type": "array", "items": { "$ref": "#/components/schemas/LibraryModel" } } } } } } } }
      }
    },
    "/api/models/{id}/pull": {
      "post": {
        "tags": ["common"],
        "summary": "Download a catalog model",
        "description": "text/event-stream of progress objects; the last one has `done: true`. A failure is sent as an Error object and ends the stream. Re-running resumes a partial download.",
        "parameters": [{ "$ref": "#/components/parameters/ModelId" }],
        "responses": { "200": { "description": "Progress stream", "content": { "text/event-stream": { "schema": { "type": "string" } } } }, "404": { "$ref": "#/components/responses/Error" }, "429": { "description": "Two downloads are already in progress", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } }
      }
    },
    "/api/models/{id}/load": {
      "post": {
        "tags": ["common"],
        "summary": "Load a model into the single slot",
        "parameters": [{ "$ref": "#/components/parameters/ModelId" }],
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "type": "object", "properties": { "device": { "type": "string", "enum": ["auto", "cpu", "gpu"] }, "n_ctx": { "type": "integer", "minimum": 1 } } } } } },
        "responses": { "200": { "description": "Loaded model with proof fields", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoadedModelInfo" } } } }, "404": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/unload": {
      "post": {
        "tags": ["common"],
        "summary": "Unload the loaded model",
        "responses": { "204": { "description": "Unloaded (or nothing was loaded)" } }
      }
    },
    "/api/shutdown": {
      "post": {
        "tags": ["common"],
        "summary": "Stop the daemon gracefully",
        "description": "The path SIGTERM takes, for callers that cannot signal the process (the desktop app on Windows): in-flight generations are cancelled, HTTP connections get up to 5 s to drain, the peer endpoint is closed (mDNS goodbye, QUIC close) and the loaded model is unloaded (engine stopped), then the process exits. No body. Same auth, origin and Host checks as every route.",
        "responses": { "202": { "description": "Shutting down", "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "const": "shutting_down" } } } } } } }
      }
    },
    "/api/models/{id}": {
      "delete": {
        "tags": ["common"],
        "summary": "Remove a downloaded model",
        "description": "Unloads it first if loaded; deletes the manifest and the blob when no other manifest shares it.",
        "parameters": [{ "$ref": "#/components/parameters/ModelId" }],
        "responses": { "204": { "description": "Removed" }, "404": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/models/import": {
      "post": {
        "tags": ["common"],
        "summary": "Import a local GGUF file",
        "description": "Hashes and links the file into the store; the file is not moved. `path` must be absolute.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "path": { "type": "string" }, "id": { "type": "string" }, "license": { "type": "string" } }, "required": ["path"] } } } },
        "responses": { "200": { "description": "Manifest", "content": { "application/json": { "schema": { "type": "object" } } } }, "400": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/network": {
      "get": {
        "tags": ["mesh"],
        "summary": "Peer networking status",
        "responses": { "200": { "description": "Status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NetworkStatus" } } } } }
      },
      "put": {
        "tags": ["mesh"],
        "summary": "Switch peer networking and serving on or off",
        "description": "Persisted in `COMMON_HOME/config.json` (0600). `enabled` binds (or closes) the authenticated QUIC endpoint, mDNS advertising/browsing and the inbound accept loop; `serve_peers` lets paired devices in a group whose policy allows it run models here. A change restarts the endpoint, so open peer connections are re-established. When the endpoint cannot start, networking is recorded as off and the error is returned. The same file's optional `peer_quota` object (`requests_per_minute`, `tokens_per_minute`, `max_concurrent`; defaults 120, 200000, 4; 0 = unlimited for the two rates) limits what each paired device may run here and is read when the daemon starts: a peer request beyond it, or one that finds no free engine slot (the daemon's `--max-concurrent` slots), gets `overloaded` at the sending device; a peer never waits in the local queue, and peer generations across all devices are capped at `max_concurrent` and at one fewer than the engine slots, so a peer never holds the slot local work needs (`peer_slots` in the status; 0 with `--max-concurrent 1`, which serves no peers).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "serve_peers": { "type": "boolean" } } } } } },
        "responses": { "200": { "description": "Status after the change", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NetworkStatus" } } } }, "400": { "$ref": "#/components/responses/Error" }, "500": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/peers": {
      "get": {
        "tags": ["mesh"],
        "summary": "Paired, discovered and revoked devices",
        "description": "`peers` are pinned devices with `connected`, `health`, `last_error` and their groups. `discovered` are devices mDNS currently sees, never this device; `trusted` is true only when pinned here and never a trust decision by itself (the transport's verifier decides). `revocations` are the signed revocations this store holds.",
        "responses": { "200": { "description": "Peers", "content": { "application/json": { "schema": { "type": "object", "properties": { "peers": { "type": "array", "items": { "$ref": "#/components/schemas/PeerRecord" } }, "discovered": { "type": "array", "items": { "$ref": "#/components/schemas/DiscoveredPeer" } }, "revocations": { "type": "array", "items": { "$ref": "#/components/schemas/Revocation" } } } } } } } }
      }
    },
    "/api/peers/{id}": {
      "delete": {
        "tags": ["mesh"],
        "summary": "Unpair a device",
        "description": "Removes the pin and closes its connections. The device may pair again (use revoke to forbid that).",
        "parameters": [{ "$ref": "#/components/parameters/PeerId" }],
        "responses": { "204": { "description": "Removed" }, "400": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/peers/{id}/revoke": {
      "post": {
        "tags": ["mesh"],
        "summary": "Revoke a device",
        "description": "Unpins it, records a revocation signed by this device, closes every connection to it with the REVOKED close code and sends the revocation to the connected devices that shared a group with it here, which apply it too and pass it on the same way; every new connection offers it again until that device has sent it back, and a device that already holds it ignores it. The revoked key fails inside the TLS handshake from now on; audit `peer_revoked`.",
        "parameters": [{ "$ref": "#/components/parameters/PeerId" }],
        "responses": { "200": { "description": "The signed revocation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Revocation" } } } }, "400": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/peers/{id}/connect": {
      "post": {
        "tags": ["mesh"],
        "summary": "Connect to a paired device now, optionally at a given address",
        "description": "For networks that drop mDNS and devices whose IP changed. Nothing is sent for an id that is not paired here (403 `peer_unauthorized`). Dials `addr` (when given), then the addresses mDNS sees, then the pinned `last_addr`; an open connection is returned as is. Every address is only a hint: the TLS handshake must present the device's pinned key, so another device at that address is refused (403 `peer_unauthorized`) and nothing is stored. `last_addr` changes only after a handshake at that address returned the connection. Clears the device's redial backoff. 403 `policy_denied` while networking is off; 403 `peer_revoked`; 426 `protocol_incompatible`; 502 `peer_lost` when nothing answered; 504 `timeout` for a control handshake that did not finish.",
        "parameters": [{ "$ref": "#/components/parameters/PeerId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "addr": { "type": "string", "description": "ip:port where the device can be reached now (not port 0, an unspecified or a multicast address)." } } } } } },
        "responses": { "200": { "description": "Connected; the device's record", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PeerRecord" } } } }, "400": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "426": { "$ref": "#/components/responses/Error" }, "502": { "$ref": "#/components/responses/Error" }, "504": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/pair/start": {
      "post": {
        "tags": ["mesh"],
        "summary": "Open a pairing window and show the code",
        "description": "Requires peer networking on. One window at a time (409 `overloaded` while one is open). Opens the separate accept-any pairing endpoint for `expires_at - now` seconds, advertises `pair=1` on mDNS and returns the single-use 6-digit code, `pair_addr` (the `ip:port` another device dials; the LAN address of the default route when the endpoint is bound on every interface) and the QR payload carrying that address (`common-pair:v1:<peer id>:<ip:port>:<secret>`). More than 5 wrong codes lock the window (`pairing_locked`); turning networking off closes it (`cancelled`). `GET /api/pair/status` reports the outcome.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string", "description": "This device's name as the other side will see it (<= 64 bytes); empty or absent: this host's name (`device_name` in GET /api/network)." } } } } } },
        "responses": { "200": { "description": "Pairing window", "content": { "application/json": { "schema": { "type": "object", "properties": { "code": { "type": "string" }, "port": { "type": "integer" }, "pair_addr": { "type": "string", "description": "ip:port of the pairing endpoint as another device dials it" }, "qr_payload": { "type": "string" }, "expires_at": { "type": "integer", "description": "Unix seconds" } } } } } }, "403": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/pair/status": {
      "get": {
        "tags": ["mesh"],
        "summary": "Outcome of the current or last pairing window",
        "responses": { "200": { "description": "Status", "content": { "application/json": { "schema": { "type": "object", "properties": { "active": { "type": "boolean" }, "port": { "type": "integer" }, "expires_at": { "type": "integer" }, "result": { "oneOf": [{ "type": "null" }, { "type": "object", "properties": { "peer": { "$ref": "#/components/schemas/PeerRecord" } } }, { "type": "object", "properties": { "error": { "type": "object" } } }] } } } } } } }
      }
    },
    "/api/pair/join": {
      "post": {
        "tags": ["mesh"],
        "summary": "Join another device's pairing window",
        "description": "Connects from this device's peer endpoint (networking must be on) to `addr` (the other device's pairing endpoint `ip:port`, required with a 6-digit code) and runs the SPAKE2 exchange bound to the TLS session. `code` may instead be the whole QR payload, whose address and expected peer id are then used: any other device that answers fails the TLS handshake (`pairing_failed`, audit reason `qr_peer_mismatch`) and nothing is pinned on either side. On success both devices pin each other; a wrong code is `pairing_failed` (401), a locked window `pairing_locked` (429).",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "addr": { "type": "string" }, "code": { "type": "string" }, "name": { "type": "string", "description": "This device's name as the other side will see it; empty or absent: this host's name." } }, "required": ["code"] } } } },
        "responses": { "200": { "description": "The newly pinned device", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PeerRecord" } } } }, "400": { "$ref": "#/components/responses/Error" }, "401": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/groups": {
      "get": {
        "tags": ["mesh"],
        "summary": "Trust groups",
        "responses": { "200": { "description": "Groups", "content": { "application/json": { "schema": { "type": "object", "properties": { "groups": { "type": "array", "items": { "$ref": "#/components/schemas/Group" } } } } } } } }
      },
      "put": {
        "tags": ["mesh"],
        "summary": "Create or replace one group",
        "description": "A paired device can run or serve a workload only through a group whose policy allows that kind; the default policy denies everything. Returns the full list.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Group" } } } },
        "responses": { "200": { "description": "Groups", "content": { "application/json": { "schema": { "type": "object", "properties": { "groups": { "type": "array", "items": { "$ref": "#/components/schemas/Group" } } } } } } }, "400": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/privacy": {
      "get": {
        "tags": ["mesh"],
        "summary": "Privacy mode and the disclosure text",
        "responses": { "200": { "description": "Mode", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PrivacyStatus" } } } } }
      },
      "put": {
        "tags": ["mesh"],
        "summary": "Change the privacy mode",
        "description": "`local_only` (default) always succeeds. `trusted_group` requires `\"acknowledged\": true`; without it the response is 403 `policy_denied` whose message is the disclosure text the user must see (a paired device decrypts and reads the prompt it runs). `swarm_allowed` is refused until its security gate. Persisted; audited as `privacy_changed`.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "mode": { "type": "string", "enum": ["local_only", "trusted_group", "swarm_allowed"] }, "acknowledged": { "type": "boolean", "default": false } }, "required": ["mode"] } } } },
        "responses": { "200": { "description": "Mode after the change", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PrivacyStatus" } } } }, "400": { "$ref": "#/components/responses/Error" }, "403": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/api/audit": {
      "get": {
        "tags": ["mesh"],
        "summary": "Recent audit events",
        "description": "The last `n` events (1..=1000, default 100) of `COMMON_HOME/logs/audit.jsonl`, oldest first: pairing, connections, revocations, settings changes and remote requests. Ids, counts, codes and durations only; never prompt text or key material. A request sent to a peer leaves `remote_request` entries on both devices: on the sender `phase: sent` before anything leaves (the request is refused when it cannot be written) then `phase: finished` (outcome, `request_id`), on the server one entry with the outcome and the same `request_id`.",
        "parameters": [{ "name": "n", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 } }],
        "responses": { "200": { "description": "Events", "content": { "application/json": { "schema": { "type": "object", "properties": { "events": { "type": "array", "items": { "$ref": "#/components/schemas/AuditEvent" } } } } } } }, "500": { "$ref": "#/components/responses/Error" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer" } },
    "parameters": {
      "ModelId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,199}$" }, "description": "Catalog or store id." },
      "PeerId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "A device's 64-hex peer id, or the `xxxx-xxxx-xxxx` short label of a paired device." },
      "Target": { "name": "X-Common-Target", "in": "header", "required": false, "schema": { "type": "string" }, "description": "Same as the body field `target`; the body wins when both are present." }
    },
    "responses": {
      "Error": { "description": "Error in the OpenAI shape with a stable Common code", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": { "type": "string" },
              "type": { "type": "string", "enum": ["invalid_request_error", "authentication_error", "permission_error", "not_found_error", "rate_limit_error", "server_error"] },
              "code": { "type": "string", "enum": ["invalid_request", "model_not_found", "model_not_downloaded", "model_file_invalid", "integrity_mismatch", "insufficient_memory", "context_too_long", "backend_unavailable", "backend_failed", "gpu_unavailable", "timeout", "cancelled", "overloaded", "download_failed", "not_implemented", "policy_denied", "unauthorized", "io", "internal", "peer_unauthorized", "peer_revoked", "pairing_locked", "pairing_failed", "peer_lost", "protocol_incompatible", "frame_too_large"] },
              "param": { "type": "null" },
              "hint": { "type": ["string", "null"] }
            },
            "required": ["message", "type", "code"]
          }
        },
        "required": ["error"]
      },
      "Model": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "object": { "const": "model" },
          "created": { "type": "integer" },
          "owned_by": { "type": "string" },
          "common": { "type": "object", "properties": { "downloaded": { "type": "boolean" }, "license": { "type": "string" }, "bytes": { "type": "integer" }, "redistribution": { "type": "string" }, "loaded": { "type": "boolean" } } }
        }
      },
      "LibraryModel": {
        "type": "object",
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" }, "bytes": { "type": "integer" }, "license": { "type": "string" }, "license_url": { "type": ["string", "null"] }, "source": { "type": "string" }, "family": { "type": ["string", "null"] }, "parameters": { "type": ["string", "null"] }, "quantization": { "type": ["string", "null"] }, "chat": { "type": "boolean" }, "redistribution": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "downloaded": { "type": "boolean" }, "loaded": { "type": "boolean" },
          "fit": { "type": "object", "properties": { "verdict": { "type": "string", "enum": ["fits", "too_large"] }, "headroom_bytes": { "type": "integer" }, "needed_bytes": { "type": "integer" }, "available_bytes": { "type": "integer" }, "reason": { "type": "string" } } },
          "estimate": { "type": "object", "properties": { "weights_bytes": { "type": "integer" }, "kv_cache_bytes": { "type": "integer" }, "compute_buffer_bytes": { "type": "integer" }, "overhead_bytes": { "type": "integer" }, "total_bytes": { "type": "integer" }, "n_ctx": { "type": "integer" } } },
          "estimate_basis": { "type": "string", "enum": ["gguf", "file_size"] }
        }
      },
      "LoadedModelInfo": {
        "type": "object",
        "properties": {
          "model_id": { "type": "string" }, "model_sha256": { "type": "string" }, "backend_name": { "type": "string" }, "backend_version": { "type": "string" }, "device_requested": { "type": "string" }, "device_actual": { "type": "string" }, "offloaded_layers": { "type": "integer" }, "total_layers": { "type": "integer" }, "n_ctx": { "type": "integer" }, "threads": { "type": "integer" }, "parallel_slots": { "type": "integer" }, "fallback_reason": { "type": ["string", "null"] }, "load_ms": { "type": "number" }, "pid": { "type": ["integer", "null"] }
        }
      },
      "Sampling": {
        "type": "object",
        "properties": {
          "model": { "type": "string", "description": "Catalog or store id. Required." },
          "max_tokens": { "type": "integer", "minimum": 1, "default": 256 },
          "max_completion_tokens": { "type": "integer", "minimum": 1 },
          "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.8 },
          "top_p": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.95 },
          "seed": { "type": "integer" },
          "stop": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
          "stream": { "type": "boolean", "default": false },
          "stream_options": { "type": "object", "properties": { "include_usage": { "type": "boolean" } } },
          "response_format": { "type": "object", "properties": { "type": { "type": "string", "enum": ["text", "json_object", "json_schema"] }, "json_schema": { "type": "object", "properties": { "name": { "type": "string" }, "schema": { "type": "object" } } } } },
          "n": { "type": "integer", "const": 1 },
          "target": { "type": "string", "default": "local", "description": "Common extension. `local` runs here. `peer:<peer id or short label>` runs the whole request on that paired device (remote execution; the device decrypts and reads the prompt). Allowed only when privacy is `trusted_group`, networking is on and the device is pinned, not revoked and in a group allowing remote inference; otherwise 403 `policy_denied` / `peer_unauthorized` / `peer_revoked` before anything runs or connects. Every response echoes `target`." }
        },
        "required": ["model"]
      },
      "ChatRequest": {
        "allOf": [
          { "$ref": "#/components/schemas/Sampling" },
          { "type": "object", "properties": { "messages": { "type": "array", "minItems": 1, "items": { "type": "object", "properties": { "role": { "type": "string", "enum": ["system", "user", "assistant", "tool", "developer"] }, "content": { "oneOf": [{ "type": "string" }, { "type": "null" }, { "type": "array", "items": { "type": "object", "properties": { "type": { "const": "text" }, "text": { "type": "string" } } } }] } }, "required": ["role"] } }, "tools": { "type": "array", "items": { "type": "object" } }, "tool_choice": {} }, "required": ["messages"] }
        ]
      },
      "Usage": { "type": "object", "properties": { "prompt_tokens": { "type": "integer" }, "completion_tokens": { "type": "integer" }, "total_tokens": { "type": "integer" } } },
      "Timings": { "type": "object", "description": "Common extension: engine timings.", "properties": { "time_to_first_token_ms": { "type": ["number", "null"] }, "prompt_ms": { "type": ["number", "null"] }, "prompt_tokens_per_second": { "type": ["number", "null"] }, "decode_ms": { "type": ["number", "null"] }, "decode_tokens_per_second": { "type": ["number", "null"] } } },
      "ChatResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" }, "object": { "const": "chat.completion" }, "created": { "type": "integer" }, "model": { "type": "string" },
          "choices": { "type": "array", "items": { "type": "object", "properties": { "index": { "type": "integer" }, "message": { "type": "object", "properties": { "role": { "const": "assistant" }, "content": { "type": ["string", "null"] }, "tool_calls": { "type": "array", "items": { "type": "object" } } } }, "logprobs": { "type": "null" }, "finish_reason": { "type": "string" } } } },
          "usage": { "$ref": "#/components/schemas/Usage" }, "timings": { "$ref": "#/components/schemas/Timings" },
          "target": { "type": "string", "description": "Where it ran: `local` or `peer:<peer id>`." }
        }
      },
      "CompletionRequest": {
        "allOf": [
          { "$ref": "#/components/schemas/Sampling" },
          { "type": "object", "properties": { "prompt": { "oneOf": [{ "type": "string" }, { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string" } }] } }, "required": ["prompt"] }
        ]
      },
      "CompletionResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" }, "object": { "const": "text_completion" }, "created": { "type": "integer" }, "model": { "type": "string" },
          "choices": { "type": "array", "items": { "type": "object", "properties": { "index": { "type": "integer" }, "text": { "type": "string" }, "logprobs": { "type": "null" }, "finish_reason": { "type": "string" } } } },
          "usage": { "$ref": "#/components/schemas/Usage" }, "timings": { "$ref": "#/components/schemas/Timings" },
          "target": { "type": "string", "description": "Where it ran: `local` or `peer:<peer id>`." }
        }
      },
      "EmbeddingsRequest": {
        "type": "object",
        "properties": { "model": { "type": "string" }, "input": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] }, "encoding_format": { "type": "string", "enum": ["float", "base64"] } },
        "required": ["model", "input"]
      },
      "EmbeddingsResponse": {
        "type": "object",
        "properties": {
          "object": { "const": "list" },
          "data": { "type": "array", "items": { "type": "object", "properties": { "object": { "const": "embedding" }, "index": { "type": "integer" }, "embedding": { "oneOf": [{ "type": "array", "items": { "type": "number" } }, { "type": "string" }] } } } },
          "model": { "type": "string" },
          "usage": { "type": "object", "properties": { "prompt_tokens": { "type": "integer" }, "total_tokens": { "type": "integer" } } }
        }
      },
      "NetworkStatus": {
        "type": "object",
        "properties": { "enabled": { "type": "boolean" }, "serve_peers": { "type": "boolean" }, "listen_addr": { "type": ["string", "null"], "description": "`ip:port` of the QUIC endpoint while enabled." }, "mdns": { "type": "boolean" }, "peer_id": { "type": "string", "description": "This device's 64-hex id (its Ed25519 public key)." }, "short_label": { "type": "string" }, "connections": { "type": "integer" }, "device_name": { "type": "string", "description": "This host's name (the Computer Name on macOS, the hostname on other unix, COMPUTERNAME on Windows): the default name a paired device sees." }, "dial_addr": { "type": ["string", "null"], "description": "`ip:port` other devices should dial (the default-route address when the endpoint is bound on every interface); null while networking is off or when no route gives one." }, "peer_quota": { "$ref": "#/components/schemas/PeerQuota" }, "peer_slots": { "type": "integer", "description": "Peer generations this device runs at once across all devices: `peer_quota.max_concurrent`, at most the engine slots (`--max-concurrent`) minus one." } }
      },
      "PeerQuota": {
        "type": "object",
        "description": "`config.json` `peer_quota` in force (read at daemon start): per paired device, requests per minute and generated tokens per minute (0 = unlimited; a request's whole max_tokens is charged when it starts) and generations at once (also the cap across all devices, see `peer_slots`).",
        "properties": { "requests_per_minute": { "type": "integer", "default": 120 }, "tokens_per_minute": { "type": "integer", "default": 200000 }, "max_concurrent": { "type": "integer", "default": 4 } }
      },
      "PeerRecord": {
        "type": "object",
        "properties": { "id": { "type": "string" }, "short_label": { "type": "string" }, "name": { "type": "string" }, "paired_at_utc": { "type": "string" }, "last_seen_utc": { "type": ["string", "null"] }, "last_addr": { "type": ["string", "null"] }, "connected": { "type": "boolean" }, "health": { "type": "string", "enum": ["connected", "unhealthy", "reconnecting", "disconnected"], "description": "Liveness from keep-alives (F-02-05), updated within one keep-alive interval: `unhealthy` = still open but 3 intervals without a datagram; `reconnecting` = lost, a reconnect is expected; `disconnected` = closed on purpose, networking off, or never connected since networking started." }, "last_error": { "oneOf": [{ "type": "null" }, { "$ref": "#/components/schemas/DialError" }], "description": "The latest failed dial to this device since its last connection (either direction); null when there is none or networking is off." }, "groups": { "type": "array", "items": { "type": "string" } } }
      },
      "DiscoveredPeer": {
        "type": "object",
        "properties": { "id": { "type": "string" }, "addr": { "type": "string", "description": "The best address, `addrs[0]`." }, "addrs": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 2, "description": "ip:port addresses from the signed record, best first (routable before loopback and link-local, IPv4 first)." }, "pairing": { "type": "boolean" }, "pair_port": { "type": ["integer", "null"] }, "proto": { "type": "string" }, "trusted": { "type": "boolean" }, "seen_utc": { "type": "string" } }
      },
      "DialError": {
        "type": "object",
        "description": "A failed outbound dial.",
        "properties": { "addr": { "type": "string" }, "code": { "type": "string", "description": "An Error code, e.g. peer_lost (nothing answered), peer_unauthorized (another device or key at that address, or it refused this one)." }, "message": { "type": "string" }, "hint": { "type": ["string", "null"] }, "at_utc": { "type": "string" } },
        "required": ["addr", "code", "message", "at_utc"]
      },
      "Group": {
        "type": "object",
        "properties": { "name": { "type": "string", "maxLength": 64 }, "members": { "type": "array", "items": { "type": "string" }, "maxItems": 256 }, "policy": { "type": "object", "properties": { "allow_remote_inference": { "type": "boolean", "default": false }, "allow_pooled_inference": { "type": "boolean", "default": false } } } },
        "required": ["name", "members"]
      },
      "Revocation": {
        "type": "object",
        "properties": { "seq": { "type": "integer" }, "peer_id": { "type": "string" }, "revoked_by": { "type": "string" }, "at_utc": { "type": "string" }, "signature": { "type": "string", "description": "Ed25519 by `revoked_by`, hex." } }
      },
      "PrivacyStatus": {
        "type": "object",
        "properties": { "mode": { "type": "string", "enum": ["local_only", "trusted_group", "swarm_allowed"] }, "disclosure": { "type": "string" } }
      },
      "AuditEvent": {
        "type": "object",
        "properties": { "ts_utc": { "type": "string" }, "kind": { "type": "string" }, "peer_id": { "type": "string" }, "fields": { "type": "object" } }
      }
    }
  }
}
